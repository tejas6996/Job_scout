# Root reference for environment variables.
# The backend reads its own server/.env — copy server/.env.example to server/.env.
#
# Jobicy and Remotive need no key, so the app runs with zero configuration —
# but those two are global-remote sources, not India-native. For real Indian
# listings (Adzuna, JSearch) and the Stage B LLM classifier, add the keys
# documented in server/.env.example. Non-secret config (locations, keywords,
# thresholds, source toggles) lives in /config/india.yaml.

# Port the backend API listens on
PORT=8787

# Comma-separated list of origins allowed to call the API (the frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# How long (ms) to cache fetched jobs before refreshing from the sources
CACHE_TTL_MS=1800000
