# Copy to pipeline/.env and fill in. Never commit the real .env (already gitignored).

# --- Search config (matches the n8n "Config" node defaults) ---
LOCATION=Bangalore
COUNTRY=in
ROLE_KEYWORDS=data analyst,data engineer,business analyst,bi analyst,business intelligence,analytics engineer,machine learning,ml engineer,ai engineer,data science
MAX_DAYS=6
MAX_EXPERIENCE_YEARS=2
INCLUDE_REMOTE=false
# JSON array of { "type": "greenhouse" | "lever", "token": "company-board-token" }
# Free and unbounded per company (Greenhouse/Lever return the whole board in one
# call) - adding companies here is the single best way to raise volume without
# touching any rate-limited quota. Verified working + Bangalore-relevant as of
# 2026-07: groww/postman (greenhouse), cred (lever). Add more anytime.
ATS_COMPANIES=[{"type":"greenhouse","token":"groww"},{"type":"greenhouse","token":"postman"},{"type":"lever","token":"cred"}]
# Adzuna: jobs per page (confirmed max 50 on this account's plan) and how many
# pages to pull per run. Adzuna's daily call budget is generous.
RESULTS_PER_SOURCE=50
ADZUNA_PAGES=3
# JSearch: pages folded into ONE request (doesn't cost extra quota) - but this
# key has a fixed TOTAL request cap (not daily), so keep modest.
JSEARCH_NUM_PAGES=3
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Notion (required) ---
# Internal integration token, shared with the "Get Notion Profile Blocks",
# "Get Existing Job IDs" and "Create Notion Page" steps.
NOTION_TOKEN=
# The Notion database that stores scouted jobs (has Job ID / Company / Apply Link / ... properties)
NOTION_DATABASE_ID=
# The Notion page containing your profile text (read as plain blocks)
PROFILE_PAGE_ID=

# --- JSearch (RapidAPI) ---
JSEARCH_API_KEY=

# --- Adzuna (https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Gemini (Google AI Studio) ---
GEMINI_API_KEY=

# --- Optional: Google Alerts RSS feed (disabled unless a URL is set) ---
GOOGLE_ALERTS_FEED_URL=

# --- Webhook + scheduler ---
PORT=8788
# Cron runs at 8am/12pm/4pm/8pm in this timezone (matches "Every 4h 8am-8pm IST")
CRON_TIMEZONE=Asia/Kolkata
