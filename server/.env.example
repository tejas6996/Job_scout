# Copy this file to `.env` and adjust if needed.
# Every source used by JobScout is a free, keyless public API, so the defaults
# below work out of the box — no secrets required.

# Port the API listens on
PORT=8787

# Comma-separated allow-list of front-end origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Cache lifetime for fetched jobs, in milliseconds (default 30 min)
CACHE_TTL_MS=1800000

# Per-source upstream request timeout, in milliseconds
FETCH_TIMEOUT_MS=12000
