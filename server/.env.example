# Copy this file to `.env` and adjust if needed.
# Jobicy and Remotive are free, keyless public APIs and work out of the box.
# Adzuna, JSearch and the Stage B (Gemini) classifier need their own keys —
# without them those sources/features degrade gracefully to "off" rather
# than failing the run (see MIGRATION.md).
#
# Non-secret pipeline config (locations, role keywords, thresholds, source
# toggles) lives in /config/india.yaml, not here — .env is for secrets only.

# Port the API listens on
PORT=8787

# Comma-separated allow-list of front-end origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Cache lifetime for fetched jobs, in milliseconds (default 30 min)
CACHE_TTL_MS=1800000

# Per-source upstream request timeout, in milliseconds
FETCH_TIMEOUT_MS=12000

# --- Adzuna (https://developer.adzuna.com) — optional, India job listings ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- JSearch / RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch) — optional ---
JSEARCH_API_KEY=

# --- Gemini (https://aistudio.google.com) — optional, powers the Stage B
# fresher classifier for postings Stage A's rules can't resolve. Without
# this key, undecided postings are excluded rather than guessed at. ---
GEMINI_API_KEY=
